# ========================================================
# Finance-Note (DompetKu) - Environment Configuration
# ========================================================

# URL Domain Aplikasi (Sesuaikan dengan domain atau IP Anda)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Kredensial Google OAuth 2.0 (Login Gmail & Cloud Sync)
# Dapatkan dari: https://console.cloud.google.com/apis/credentials
# 1. Buat Project Baru di Google Cloud Console
# 2. Masuk ke "APIs & Services" -> "OAuth consent screen", pilih User Type External
# 3. Masuk ke "Credentials" -> "Create Credentials" -> "OAuth client ID"
# 4. Application type: "Web application"
# 5. Authorized redirect URIs:
#    - http://localhost:3100/api/auth/google/callback
#    - https://domain-anda.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Path Database SQLite (Otomatis /app/data/finance.sqlite di Docker)
DATABASE_PATH=./data/finance.sqlite
